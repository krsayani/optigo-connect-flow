# Optional: preferred email provider (falls back to FormSubmit if unset)
RESEND_API_KEY=
RESEND_FROM=OptiGo <onboarding@resend.dev>

# Where form submissions are delivered
NOTIFY_EMAIL=krsayani11@gmail.com

# Used as Origin for FormSubmit delivery
PUBLIC_SITE_URL=https://optigo.app

# Supabase / Lovable Cloud (injected automatically on Lovable hosting)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional server-only key for writes that bypass RLS
SUPABASE_SERVICE_ROLE_KEY=

# Server-only auth — never prefix these with VITE_
# SESSION_SECRET must be at least 32 characters (openssl rand -base64 48)
SESSION_SECRET=
# Optional env-credential fallback if you are not using a Supabase Auth user
AUTH_USERNAME=
AUTH_PASSWORD=
AUTH_EMAIL=
AUTH_DISPLAY_NAME=
